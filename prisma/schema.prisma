generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  emailVerified Boolean          @default(false)
  incomeRange   IncomeRange      @default(PREFER_NOT_TO_SAY)
  accounts      Account[]
  categories    Category[]
  consumptions  Consumption[]
  goals         Goal[]
  items         Item[]
  sessions      Session[]
  wishList      WishList?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Item {
  id            String         @id @default(cuid())
  friendlyName  String
  systemName    String
  brand         String

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  imageUrl      String?

  consumptions  Consumption[]
  wishListItems WishListItem[]

  @@unique([systemName, brand, userId])
}

model Type {
  id                String              @id @default(cuid())
  name              String              @unique

  categories        Category[]
  consumptionReasons ConsumptionReason[]
  negativeAspects   NegativeAspect[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Category {
  id           String   @id @default(cuid())
  friendlyName  String
  systemName    String

  typeId       String
  type         Type     @relation(fields: [typeId], references: [id])

  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  items        Item[]
  goals        Goal[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([systemName, userId])
}

model WishList {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishListItem[]
}

model WishListItem {
  id           String               @id @default(cuid())
  wishListId   String
  itemId       String
  priority     WishListItemPriority
  goal         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  consumptions Consumption[]
  item         Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  wishList     WishList             @relation(fields: [wishListId], references: [id], onDelete: Cascade)

  @@unique([wishListId, itemId])
}

model ConsumptionReason {
  id          String       @id @default(cuid())
  systemName  String
  friendlyName String

  typeId      String
  type        Type         @relation(fields: [typeId], references: [id])

  consumptions Consumption[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([systemName, typeId])
}

model NegativeAspect {
  id           String       @id @default(cuid())
  systemName   String
  friendlyName String

  typeId       String
  type         Type         @relation(fields: [typeId], references: [id])

  consumptions ConsumptionNegativeAspect[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([systemName, typeId])
}

model Consumption {
  id                String                    @id @default(cuid())

  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId            String
  item              Item                      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  wishListItemId    String?
  wishListItem      WishListItem?             @relation(fields: [wishListItemId], references: [id])

  consumptionReasonId String
  consumptionReason   ConsumptionReason       @relation(fields: [consumptionReasonId], references: [id])

  wouldBuyAgain     Boolean?
  influence         ConsumptionInfluence

  price             Float
  rating            Float?

  details           String?
  address           String?

  consumptionDate   DateTime
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  negativeAspects   ConsumptionNegativeAspect[]
}

model ConsumptionNegativeAspect {
  consumptionId   String
  negativeAspectId String

  consumption     Consumption   @relation(
    fields: [consumptionId],
    references: [id],
    onDelete: Cascade
  )

  negativeAspect   NegativeAspect @relation(
    fields: [negativeAspectId],
    references: [id],
    onDelete: Cascade
  )

  @@id([consumptionId, negativeAspectId])
}

model Goal {
  id          String    @id @default(cuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  initialDate DateTime  @default(now())
  finalDate   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  spendingGoal      SpendingGoal?
  categoryGoal      CategoryGoal?
  satisfactionGoal  SatisfactionGoal?
  impulsivityGoal   ImpulsivityGoal?
}

model SpendingGoal {
  goalId         String @id
  goal           Goal @relation(fields: [goalId], references: [id])

  spendingLimit  Float

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
}

model SatisfactionGoal {
  goalId        String   @id

  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  targetRating  Float
}

model ImpulsivityGoal {
  goalId          String   @id

  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  targetDecrease  Float?
}

enum WishListItemPriority {
  HIGH
  MEDIUM
  LOW
}

enum ConsumptionReason {
  ITEM_REPLACEMENT
  EFFECTIVENESS_TEST
  PERSONAL_SATISFACTION
  SOCIAL_ALIGNMENT
  OTHER
}

enum ConsumptionInfluence {
  SOCIAL_MEDIA
  FRIENDS_FAMILY
  SOCIETY_TREND
  OWN_RESEARCH
  IMPULSIVITY
  EMERGENCY
  SELLER_INFLUENCE
  REDUCED_COST
  OTHER
}

enum IncomeRange {
  UP_TO_1_MINIMUM_WAGE
  FROM_1_TO_3
  FROM_3_TO_5
  FROM_5_TO_10
  ABOVE_10
  PREFER_NOT_TO_SAY
}

