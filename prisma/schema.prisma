generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Item {
  friendlyName  String         @db.VarChar(30)
  systemName    String         @db.VarChar(30)
  categoryId    String
  id            String         @id @default(cuid())
  brand         String         @db.VarChar(30)
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  imageUrl      String?
  consumptions  Consumption[]
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishListItems WishListItem[]

  @@unique([systemName, brand, userId])
  @@index([categoryId])
  @@index([userId])
}

model ItemType {
  name               ItemTypeEnum        @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  id                 Int                 @id @default(autoincrement())
  categories         Category[]
  consumptionReasons ConsumptionReason[]
  negativeAspects    NegativeAspect[]
}

model Category {
  id            String         @id @default(cuid())
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  typeId        Int
  name          String         @db.VarChar(30)
  description   String?        @db.VarChar(200)
  type          ItemType       @relation(fields: [typeId], references: [id])
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals         Goal[]
  items         Item[]
  spendingGoals SpendingGoal[]

  @@unique([name, userId])
  @@index([typeId])
}

model WishList {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishListItem[]
}

model WishListItem {
  id           String               @id @default(cuid())
  wishListId   String
  itemId       String
  priority     WishListItemPriority
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  note         String?              @db.VarChar(300)
  consumptions Consumption[]
  item         Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  wishList     WishList             @relation(fields: [wishListId], references: [id], onDelete: Cascade)

  @@unique([wishListId, itemId])
}

model ConsumptionReason {
  systemName   String        @db.VarChar(30)
  friendlyName String        @db.VarChar(30)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  id           Int           @id @default(autoincrement())
  typeId       Int
  consumptions Consumption[]
  type         ItemType      @relation(fields: [typeId], references: [id])

  @@unique([systemName, typeId])
  @@index([typeId])
}

model ConsumptionInfluence {
  systemName   String        @unique @db.VarChar(30)
  friendlyName String        @db.VarChar(30)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  id           Int           @id @default(autoincrement())
  consumptions Consumption[]
}

model NegativeAspect {
  systemName   String                      @db.VarChar(80)
  friendlyName String                      @db.VarChar(80)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @default(now()) @updatedAt
  id           Int                         @id @default(autoincrement())
  typeId       Int
  consumptions ConsumptionNegativeAspect[]
  type         ItemType                    @relation(fields: [typeId], references: [id])

  @@unique([systemName, typeId])
  @@index([typeId])
}

model Consumption {
  id              String                      @id @default(cuid())
  userId          String
  itemId          String
  wishListItemId  String?
  wouldBuyAgain   Boolean
  price           Float
  rating          Float
  details         String?                     @db.VarChar(300)
  address         String?                     @db.VarChar(255)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt
  date            DateTime
  influenceId     Int
  reasonId        Int
  influence       ConsumptionInfluence        @relation(fields: [influenceId], references: [id])
  item            Item                        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reason          ConsumptionReason           @relation(fields: [reasonId], references: [id])
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishListItem    WishListItem?               @relation(fields: [wishListItemId], references: [id],   onDelete: SetNull)
  negativeAspects ConsumptionNegativeAspect[]

  @@index([itemId])
  @@index([userId])
  @@index([reasonId])
  @@index([date])
}

model ConsumptionNegativeAspect {
  consumptionId    String
  negativeAspectId Int
  consumption      Consumption    @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  negativeAspect   NegativeAspect @relation(fields: [negativeAspectId], references: [id], onDelete: Cascade)

  @@id([consumptionId, negativeAspectId])
  @@index([negativeAspectId])
}

model Goal {
  id               String            @id @default(cuid())
  userId           String
  categoryId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  finalDate        DateTime?
  initialDate      DateTime          @default(now())
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  impulsivityGoal  ImpulsivityGoal?
  satisfactionGoal SatisfactionGoal?
  spendingGoal     SpendingGoal?
}

model SpendingGoal {
  goalId        String    @id
  spendingLimit Float
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id],   onDelete: SetNull)
  goal          Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model SatisfactionGoal {
  goalId       String @id
  targetRating Float
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model ImpulsivityGoal {
  goalId                   String @id
  targetDecreasePercentage Float
  goal                     Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id
  name          String?
  email         String        @unique
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  emailVerified Boolean       @default(false)
  incomeRange   IncomeRange   @default(PREFER_NOT_TO_SAY)
  Account       Account[]
  categories    Category[]
  consumptions  Consumption[]
  goals         Goal[]
  items         Item[]
  Session       Session[]
  wishList      WishList?
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

enum WishListItemPriority {
  HIGH
  MEDIUM
  LOW
}

enum IncomeRange {
  UP_TO_1_MINIMUM_WAGE
  FROM_1_TO_3
  FROM_3_TO_5
  FROM_5_TO_10
  ABOVE_10
  PREFER_NOT_TO_SAY
}

enum ItemTypeEnum {
  PRODUCT 
  SERVICE
}
