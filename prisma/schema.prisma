generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  emailVerified Boolean       @default(false)
  incomeRange   IncomeRange   @default(PREFER_NOT_TO_SAY)
  accounts      Account[]
  categories    Category[]
  consumptions  Consumption[]
  goals         Goal[]
  items         Item[]
  sessions      Session[]
  wishList      WishList?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Item {
  id           String @id @default(cuid())
  friendlyName String @db.VarChar(30)
  systemName   String @db.VarChar(30)
  brand        String @db.VarChar(30)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrl  String?

  consumptions  Consumption[]
  wishListItems WishListItem[]

  @@unique([systemName, brand, userId])
  @@index([categoryId])
  @@index([userId])
}

model ItemType {
  id   String       @id @default(cuid())
  name ItemTypeEnum @unique

  categories         Category[]
  consumptionReasons ConsumptionReason[]
  negativeAspects    NegativeAspect[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  consumptionInfluences ConsumptionInfluence[]
}

model Category {
  id           String @id @default(cuid())
  friendlyName String @db.VarChar(30)
  systemName   String @db.VarChar(30)

  typeId String
  type   ItemType @relation(fields: [typeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]
  goals Goal[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  spendingGoals SpendingGoal[]

  @@unique([systemName, userId])
  @@index([typeId])
}

model WishList {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishListItem[]
}

model WishListItem {
  id           String               @id @default(cuid())
  wishListId   String
  itemId       String
  priority     WishListItemPriority
  note         String?              @db.VarChar(300)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  consumptions Consumption[]
  item         Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  wishList     WishList             @relation(fields: [wishListId], references: [id], onDelete: Cascade)

  @@unique([wishListId, itemId])
}

model ConsumptionReason {
  id           String @id @default(cuid())
  systemName   String @db.VarChar(30)
  friendlyName String @db.VarChar(30)

  typeId String
  type   ItemType @relation(fields: [typeId], references: [id])

  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemName, typeId])
  @@index([typeId])
}

model ConsumptionInfluence {
  id           String @id @default(cuid())
  systemName   String @db.VarChar(30)
  friendlyName String @db.VarChar(30)

  typeId String
  type   ItemType @relation(fields: [typeId], references: [id])

  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemName, typeId])
  @@index([typeId])
}

model NegativeAspect {
  id           String @id @default(cuid())
  systemName   String @db.VarChar(30)
  friendlyName String @db.VarChar(30)

  typeId String
  type   ItemType @relation(fields: [typeId], references: [id])

  consumptions ConsumptionNegativeAspect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemName, typeId])
  @@index([typeId])
}

model Consumption {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  wishListItemId String?
  wishListItem   WishListItem? @relation(fields: [wishListItemId], references: [id])

  reasonId String
  reason   ConsumptionReason @relation(fields: [reasonId], references: [id])

  wouldBuyAgain Boolean?

  influenceId String
  influence   ConsumptionInfluence @relation(fields: [influenceId], references: [id])

  price  Float
  rating Float?

  details String? @db.VarChar(300)
  address String? @db.VarChar(255)

  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negativeAspects ConsumptionNegativeAspect[]

  @@index([itemId])
  @@index([userId])
  @@index([reasonId])
  @@index([date])
}

model ConsumptionNegativeAspect {
  consumptionId    String
  negativeAspectId String

  consumption    Consumption    @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  negativeAspect NegativeAspect @relation(fields: [negativeAspectId], references: [id], onDelete: Cascade)

  @@id([consumptionId, negativeAspectId])
  @@index([negativeAspectId])
}

model Goal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  initialDate DateTime  @default(now())
  finalDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spendingGoal     SpendingGoal?
  satisfactionGoal SatisfactionGoal?
  impulsivityGoal  ImpulsivityGoal?
  category         Category?         @relation(fields: [categoryId], references: [id])
  categoryId       String?
}

model SpendingGoal {
  goalId String @id
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  spendingLimit Float

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model SatisfactionGoal {
  goalId String @id

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  targetRating Float
}

model ImpulsivityGoal {
  goalId String @id

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  targetDecreasePercentage Float
}

enum WishListItemPriority {
  HIGH
  MEDIUM
  LOW
}

enum IncomeRange {
  UP_TO_1_MINIMUM_WAGE
  FROM_1_TO_3
  FROM_3_TO_5
  FROM_5_TO_10
  ABOVE_10
  PREFER_NOT_TO_SAY
}

enum ItemTypeEnum {
  PRODUCT
  SERVICE
}
